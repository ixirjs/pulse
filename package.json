{
	"name": "@ixirjs/pulse",
	"version": "0.1.0",
	"description": "Spring-powered WAAPI animation utilities and FLIP layout transitions for Svelte 5",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ixirjs/pulse.git"
	},
	"homepage": "https://github.com/ixirjs/pulse#readme",
	"bugs": {
		"url": "https://github.com/ixirjs/pulse/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"animation",
		"flip",
		"spring",
		"waapi",
		"motion",
		"transition",
		"layout",
		"easing",
		"timeline"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"analyze": "npm run prepack && size-limit",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "npm run prepack && changeset publish"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"CHANGELOG.md",
		"LICENSE"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./animate": {
			"types": "./dist/animate/index.d.ts",
			"default": "./dist/animate/index.js"
		},
		"./flip": {
			"types": "./dist/flip/index.d.ts",
			"default": "./dist/flip/index.js"
		},
		"./easing": {
			"types": "./dist/easing/index.d.ts",
			"default": "./dist/easing/index.js"
		},
		"./scroll": {
			"types": "./dist/scroll/index.d.ts",
			"default": "./dist/scroll/index.js"
		},
		"./gestures": {
			"types": "./dist/gestures/index.d.ts",
			"default": "./dist/gestures/index.js"
		},
		"./presence": {
			"types": "./dist/presence/index.d.ts",
			"default": "./dist/presence/index.js"
		},
		"./variants": {
			"types": "./dist/variants/index.d.ts",
			"default": "./dist/variants/index.js"
		},
		"./gradient": {
			"types": "./dist/gradient/index.d.ts",
			"default": "./dist/gradient/index.js"
		},
		"./morph": {
			"types": "./dist/morph/index.d.ts",
			"default": "./dist/morph/index.js"
		},
		"./text": {
			"types": "./dist/text/index.d.ts",
			"default": "./dist/text/index.js"
		},
		"./view-transition": {
			"types": "./dist/view-transition/index.d.ts",
			"default": "./dist/view-transition/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@chromatic-com/storybook": "^5.1.2",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@size-limit/preset-small-lib": "^12.1.0",
		"@storybook/addon-a11y": "^10.3.6",
		"@storybook/addon-docs": "^10.3.6",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.3.6",
		"@storybook/sveltekit": "^10.3.6",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.3",
		"@vitest/coverage-v8": "^4.1.3",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.3.6",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"mdsvex": "^0.12.7",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"publint": "^0.3.18",
		"size-limit": "^12.1.0",
		"storybook": "^10.3.6",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0"
	}
}
